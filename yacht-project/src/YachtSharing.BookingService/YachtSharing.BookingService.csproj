<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Grpc.Net.Client" />
        <PackageReference Include="Google.Protobuf" />
        <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
        <PackageReference Include="Swashbuckle.AspNetCore" />
        <PackageReference Include="Grpc.Net.ClientFactory" />
        <PackageReference Include="AspNetCore.HealthChecks.Npgsql" />
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="..\..\Protos\catalog.proto" GrpcServices="Client" Link="Protos\catalog.proto" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="$(IntermediateOutputPath)Catalog.cs" />
        <Compile Remove="$(IntermediateOutputPath)CatalogGrpc.cs" />
        <Compile Include="$(IntermediateOutputPath)Catalog.cs" Visible="false" Condition="Exists('$(IntermediateOutputPath)Catalog.cs')" />
        <Compile Include="$(IntermediateOutputPath)CatalogGrpc.cs" Visible="false" Condition="Exists('$(IntermediateOutputPath)CatalogGrpc.cs')" />
    </ItemGroup>

</Project>
